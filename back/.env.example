# Copiá a back/.env y completá los valores

# Obligatorio en producción (string largo y aleatorio)
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Opcional: override de DB (en Docker ya se setea DB_PATH=/app/shed_data/shed.db)
# DB_PATH=/app/shed_data/shed.db
# DATABASE_URL=sqlite:////app/shed_data/shed.db

# CORS: * o lista separada por comas
ALLOWED_ORIGINS=*

# Email / notificaciones (opcional; sin esto el sistema igual corre)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
ADMIN_EMAIL=
NOTIFICATION_THRESHOLD_DAYS=7

# Admin de login (bootstrap al arrancar)
ADMIN_USER_EMAIL=admin@conkreto.local
ADMIN_USER_PASSWORD=cambia-esta-password
ADMIN_USER_NAME=Admin
ADMIN_USER_SURNAME=Sistema
