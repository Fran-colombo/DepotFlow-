# Demo frontend — build from repo root; patches apply only inside the image.
FROM node:20 AS builder
WORKDIR /app

ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

COPY front/sistema-stock/package.json front/sistema-stock/package-lock.json* ./
RUN npm install

COPY front/sistema-stock/ ./
COPY demo/ui/DemoBanner.jsx ./src/components/DemoBanner.jsx
COPY demo/ui/apply-demo-patch.sh /tmp/apply-demo-patch.sh
RUN chmod +x /tmp/apply-demo-patch.sh && /tmp/apply-demo-patch.sh
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY demo/docker/nginx.demo.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
