# Variables usadas por docker-compose (copiá a .env en la raíz del repo)

SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_ORIGINS=*

# Front build: /api = proxy nginx same-origin (recomendado en un solo VPS)
VITE_API_URL=/api

# Admin creado automáticamente al arrancar el backend (si no existe)
ADMIN_USER_EMAIL=admin@conkreto.local
ADMIN_USER_PASSWORD=cambia-esta-password
ADMIN_USER_NAME=Admin
ADMIN_USER_SURNAME=Sistema

# WhatsApp bot (n8n -> FastAPI). El mismo valor va en n8n como X-API-Key.
WHATSAPP_API_KEY=cambia-esta-clave-whatsapp

# Telegram bot (gratis, BotFather). Vacío = desactivado.
# En HTTP (VPS sin certificado) no hace falta webhook: el backend hace polling.
TELEGRAM_BOT_TOKEN=
# Opcional: usuario del bot sin @ (si falta, el backend lo pide a Telegram).
TELEGRAM_BOT_USERNAME=
# Opcional, solo si hay HTTPS público, ej: https://tudominio/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# n8n: el backend reenvía mensajes acá. Vacío = responde directo sin Ollama.
# En Docker: http://n8n:5678/webhook/inventario-telegram
TELEGRAM_N8N_WEBHOOK_URL=

# n8n (self-hosted)
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OLLAMA_URL=http://ollama:11434

# Email / notificaciones (opcional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
ADMIN_EMAIL=
NOTIFICATION_THRESHOLD_DAYS=7
